[Unit]
Description=Dify Web
After=network.target dify-api.service
Wants=dify-api.service

[Service]
Type=simple
User=dify
Group=dify
WorkingDirectory=/opt/dify/web
EnvironmentFile=/etc/shuati/env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node22/bin/node /opt/dify/web/scripts/copy-and-start.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
