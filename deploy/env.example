# /etc/shuati/env
SPRING_PROFILES_ACTIVE=prod
SHUATI_DB_URL=jdbc:mysql://127.0.0.1:3306/shuati?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
SHUATI_DB_USER=shuati
SHUATI_DB_PASSWORD=change-me
SHUATI_JWT_SECRET=change-me-at-least-32-bytes-long-secret
APP_AES_SECRET=change-me-base64-32-bytes
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# AI 编排：生产本阶段保持 direct；本地 profile 默认 dify
SHUATI_AI_ENGINE=direct
DIFY_BASE_URL=http://localhost:8501/v1
DIFY_CONNECT_TIMEOUT=10s
DIFY_READ_TIMEOUT=175s
# 生产不启用 Dify 时保持为空；本地测试 Token 只写 .env.local
DIFY_WORKFLOW_JUDGE_TOKEN=
DIFY_WORKFLOW_EXPLAIN_TOKEN=
DIFY_WORKFLOW_EXTRACT_TEXT_TOKEN=
DIFY_WORKFLOW_EXTRACT_IMAGE_TOKEN=

# 注册邮箱验证码（阿里云 DirectMail）
SHUATI_MAIL_ENABLED=true
SHUATI_MAIL_SIMULATE=false
SHUATI_MAIL_HOST=smtpdm.aliyun.com
SHUATI_MAIL_PORT=465
SHUATI_MAIL_USERNAME=no-reply@mail.seaunit.site
# 在 DirectMail 控制台设置后手动填入真实 SMTP 密码，不要提交到 Git
SHUATI_MAIL_PASSWORD=change-me
SHUATI_MAIL_FROM=no-reply@mail.seaunit.site
SHUATI_MAIL_FROM_NAME=拾题
SHUATI_EMAIL_SECRET=change-me-email-hash-secret
SHUATI_MAIL_SSL=true
SHUATI_MAIL_CONNECT_TIMEOUT_MS=10000
SHUATI_MAIL_READ_TIMEOUT_MS=10000
SHUATI_MAIL_WRITE_TIMEOUT_MS=10000
SHUATI_MAIL_CODE_TTL_SECONDS=300
SHUATI_MAIL_COOLDOWN_SECONDS=60
SHUATI_MAIL_EMAIL_DAILY_LIMIT=10
SHUATI_MAIL_IP_HOURLY_LIMIT=20
SHUATI_MAIL_DEVICE_DAILY_LIMIT=30
SHUATI_MAIL_GLOBAL_DAILY_LIMIT=2000

# 验证码模块
SHUATI_REDIS_HOST=127.0.0.1
SHUATI_REDIS_PORT=6379
SHUATI_REDIS_PASSWORD=
SHUATI_REDIS_DB=0
# 验证码加盐哈希用的密钥，务必改成随机值并妥善保存
SHUATI_CAPTCHA_SECRET=change-me-captcha-secret

# 在线支付（Waffo Pancake）
SHUATI_PAYMENTS_ENABLED=false
SHUATI_PAYMENTS_URL=http://127.0.0.1:8090
SHUATI_PAYMENTS_SECRET=change-me-payments-secret
SHUATI_PAYMENTS_CURRENCY=CNY
# 订阅币种（Waffo 不支持订阅用 CNY，保持 USD）
SHUATI_PAYMENTS_SUBSCRIPTION_CURRENCY=USD

# 首次启动引导管理员，账号已存在时会跳过（不会覆盖密码）
SHUATI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SHUATI_BOOTSTRAP_ADMIN_PASSWORD=change-me

# SEO：canonical / sitemap / robots 用的规范域名，要和百度搜索资源平台验证过的站点一致
SHUATI_SITE_URL=https://www.seaunit.site
SHUATI_SITE_NAME=拾题
SHUATI_SITE_TAGLINE=在线刷题与 AI 解析
SHUATI_CONTACT_EMAIL=sealevel666@163.com
# 百度搜索资源平台 → 普通收录 → API 提交 里的 token，用于主动推送
SHUATI_BAIDU_PUSH_TOKEN=
# Google Search Console 选「HTML 标记」验证时填这里（HTML 文件验证则不用填）
SHUATI_GOOGLE_SITE_VERIFICATION=
# GA4 衡量 ID（G-XXXXXXX），用于直出页面的访问统计
SHUATI_GA_MEASUREMENT_ID=
