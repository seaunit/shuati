# /etc/shuati/env
SPRING_PROFILES_ACTIVE=prod
SHUATI_DB_URL=jdbc:mysql://127.0.0.1:3306/shuati?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
SHUATI_DB_USER=shuati
SHUATI_DB_PASSWORD=change-me
SHUATI_JWT_SECRET=change-me-at-least-32-bytes-long-secret
APP_AES_SECRET=change-me-base64-32-bytes
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 首次启动引导管理员，账号已存在时会跳过（不会覆盖密码）
SHUATI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SHUATI_BOOTSTRAP_ADMIN_PASSWORD=change-me
