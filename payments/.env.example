# Waffo Pancake（Dashboard → API 与开发）
WAFFO_MERCHANT_ID=MER_7PGKvFIiNnnwwEO5RsJLTR
# 私钥二选一：直接给 PEM（支持 \n 转义），或给 base64（推荐 CI/CD）
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
WAFFO_ENV=test
# 默认店铺（Dashboard → 设置 → 店铺资料）
WAFFO_STORE_ID=STO_06yfSw5FByRGGzjlMVXC1n
# 商品计价币种（ISO 4217）
WAFFO_CURRENCY=CNY

# 商品映射：把本项目的商品编码映射到 Waffo 的 Product ID
# 格式 itemCode:PRODUCT_ID(,分隔)；PLAN 用 planCode:period
# 例：WAFFO_PRODUCT_MAP=PLAN:plus:MONTHLY=PROD_xxx,PACK:pack_9=PROD_yyy
WAFFO_PRODUCT_MAP=

# 本服务对外端口
PORT=8090

# 与 Java 后端互调
JAVA_BASE_URL=http://127.0.0.1:8080
# Java 调本服务、本服务调 Java 都用这个共享密钥，务必改成随机值
INTERNAL_SECRET=change-me-internal-secret

# 结账成功后跳回的地址（可选，不填用商品上的配置）
CHECKOUT_SUCCESS_URL=
