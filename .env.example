# 前端公开变量（可暴露给浏览器）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端密钥（仅 Netlify 环境变量 / 本地 .env.local）
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
APP_AES_SECRET=

# 本地维护脚本使用（scripts/*.cjs），不需要配置到 Netlify
# Supabase 数据库直连串，格式：
# postgresql://postgres.<ref>:<password>@<host>:6543/postgres
SUPABASE_DB_URL=
# scripts/ensure-admin.cjs
ADMIN_EMAIL=shuati.admin@gmail.com
ADMIN_PASSWORD=
# scripts/smoke-api.cjs
SMOKE_EMAIL=shuati.admin@gmail.com
SMOKE_PASSWORD=
SMOKE_BASE_URL=http://localhost:3000
