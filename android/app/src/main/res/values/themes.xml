        <item name="android:windowBackground">@color/page_gray</item>
        <item name="android:statusBarColor">@color/page_gray</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
